PORT=4000
CORS_ORIGIN=http://localhost:5173

# Optional: enables the LLM move coach (POST /api/coach/explain).
# Without it, the endpoint responds with a friendly "not configured" message
# instead of an error, and the rest of the app works normally.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Optional: enables saved games and accounts. Without it, /api/auth/* returns
# 503 and gameplay stays fully in-memory via Socket.io - no database needed
# to play.
DATABASE_URL=mysql://user:password@localhost:3306/chess

# Optional: enables /api/auth/register and /api/auth/login (also requires
# DATABASE_URL above). Generate a real secret for anything beyond local dev.
JWT_SECRET=
