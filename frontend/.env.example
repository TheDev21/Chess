# Base URL for REST API calls. In dev, Vite proxies /api to the backend
# (see vite.config.ts), so this can stay unset locally.
VITE_API_BASE=/api

# Socket.io server URL. In dev, Vite proxies /socket.io to the backend, so
# this can stay unset locally. In production (no dev proxy), point it at
# the backend's public URL, e.g. https://api.example.com
VITE_SOCKET_URL=/
